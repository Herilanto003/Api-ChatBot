# Copier ce fichier en .env puis adapter les valeurs.
# Le fichier .env réel ne doit JAMAIS être commité.

DATABASE_URL="postgresql://postgres:motdepasse@localhost:5432/chatbot"

APP_NAME="Chatbot API"
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DB_ECHO=false

# Clé OpenRouter (obligatoire pour POST /api/v1/chat).
# Ne jamais commiter la vraie valeur.
OPENROUTER_API_KEY=
# Modèle gratuit avec support du tool calling.
# `openrouter:minimax/minimax-m3.1-flash:free` a été retiré par OpenRouter le 22/10/2026.
OPENROUTER_MODEL=openrouter:nvidia/nemotron-3.5-lightning:free
# Plafond de génération (tokens de sortie).
OPENROUTER_MAX_TOKENS=2048
